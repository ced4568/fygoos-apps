#!/bin/bash
# Fygo OS starts and stops the Compose project declared in config/resource.
# This script only reports status. Grafana is the user-facing service, so it decides "running".

# The package user has no Docker access, so ask Grafana directly.

is_running() {
    curl -fs -o /dev/null --max-time 5 "http://127.0.0.1:${TRIM_SERVICE_PORT:-3300}/api/health"
}

case "$1" in
    start|stop)
        exit 0
        ;;
    status)
        is_running && exit 0
        exit 3
        ;;
    *)
        echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
        exit 1
        ;;
esac
