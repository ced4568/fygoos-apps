#!/bin/bash
# Shared helpers, sourced by the lifecycle scripts.
# Settings flow:
#   wizard values (env vars) -> $TRIM_PKGETC/settings.env (persists across upgrades)
#   settings.env -> $TRIM_PKGVAR/settings/* and $TRIM_PKGVAR/secrets/* (read by the containers
#                   when they start, see docker-compose.yaml)
# These scripts run as the package user, which has no access to Docker.

SETTINGS_FILE="${TRIM_PKGETC}/settings.env"
SETTINGS_DIR="${TRIM_PKGVAR}/settings"
SECRETS_DIR="${TRIM_PKGVAR}/secrets"

fail() {
    echo "$1" > "$TRIM_TEMP_LOGFILE"
    exit 1
}

# Validate and persist wizard values. Only overwrites keys the wizard actually provided.
# "save_settings live" also pushes a changed password into the running Grafana first.
save_settings() {
    mkdir -p "$TRIM_PKGETC" || fail "Cannot create the configuration directory."
    [ -f "$SETTINGS_FILE" ] && . "$SETTINGS_FILE"
    OLD_GRAFANA_PASSWORD="$GRAFANA_PASSWORD"

    if [ -n "$wizard_retention_days" ]; then
        case "$wizard_retention_days" in
            ''|*[!0-9]*) fail "Retention must be a whole number of days." ;;
        esac
        if [ "$wizard_retention_days" -lt 1 ] || [ "$wizard_retention_days" -gt 365 ]; then
            fail "Retention must be between 1 and 365 days."
        fi
        RETENTION_DAYS="$wizard_retention_days"
    fi

    if [ -n "$wizard_container_metrics" ]; then
        case "$wizard_container_metrics" in
            true|false) CONTAINER_METRICS="$wizard_container_metrics" ;;
            *) fail "Invalid value for container metrics." ;;
        esac
    fi

    if [ -n "$wizard_grafana_password" ]; then
        if [ "${#wizard_grafana_password}" -lt 8 ]; then
            fail "The Grafana password must be at least 8 characters."
        fi
        case "$wizard_grafana_password" in
            *"'"*) fail "The Grafana password cannot contain a single quote (')." ;;
        esac
        PASSWORD_CHANGED=true
        GRAFANA_PASSWORD="$wizard_grafana_password"
    fi

    RETENTION_DAYS="${RETENTION_DAYS:-15}"
    CONTAINER_METRICS="${CONTAINER_METRICS:-false}"
    [ -n "$GRAFANA_PASSWORD" ] || fail "A Grafana admin password is required."
    [ "$1" = "live" ] && apply_password_change

    umask 077
    {
        printf 'RETENTION_DAYS=%q\n' "$RETENTION_DAYS"
        printf 'CONTAINER_METRICS=%q\n' "$CONTAINER_METRICS"
        printf 'GRAFANA_PASSWORD=%q\n' "$GRAFANA_PASSWORD"
    } > "$SETTINGS_FILE" || fail "Cannot write settings."
}

# Render the files the containers read at start. Safe to run repeatedly.
render_env() {
    [ -f "$SETTINGS_FILE" ] || fail "Settings are missing. Reinstall or reconfigure the app."
    . "$SETTINGS_FILE"

    umask 022
    mkdir -p "$TRIM_PKGVAR/prometheus" "$TRIM_PKGVAR/grafana" "$SETTINGS_DIR" \
        || fail "Cannot create data directories."
    echo "${RETENTION_DAYS}d" > "$SETTINGS_DIR/retention" \
        || fail "Cannot write the settings files."
    echo "$CONTAINER_METRICS" > "$SETTINGS_DIR/container-metrics" \
        || fail "Cannot write the settings files."

    umask 077
    mkdir -p "$SECRETS_DIR" || fail "Cannot create the secrets directory."
    # Grafana only reads this when it first creates its database.
    printf '%s' "$GRAFANA_PASSWORD" > "$SECRETS_DIR/grafana-admin-password" \
        || fail "Cannot write the Grafana password file."
}

# Grafana ignores the password file once its database exists, so a new password goes in
# through the Grafana API, signed in with the old one. Runs before the new one is saved.
apply_password_change() {
    [ "$PASSWORD_CHANGED" = "true" ] || return 0
    [ -n "$OLD_GRAFANA_PASSWORD" ] || return 0
    [ "$OLD_GRAFANA_PASSWORD" != "$GRAFANA_PASSWORD" ] || return 0
    local body code
    body=$(printf '{"password":"%s"}' "$(printf '%s' "$GRAFANA_PASSWORD" | sed 's/[\\"]/\\&/g')")
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -u "admin:${OLD_GRAFANA_PASSWORD}" \
        -H 'Content-Type: application/json' -X PUT -d "$body" \
        "http://127.0.0.1:${TRIM_SERVICE_PORT:-3300}/api/admin/users/1/password")
    case "$code" in
        200) ;;
        000) fail "Grafana is not running. Start the app, then change the password again." ;;
        401) fail "Grafana rejected the saved admin password. If you changed it inside Grafana, change it there." ;;
        *)   fail "Could not update the Grafana password (HTTP $code)." ;;
    esac
}
